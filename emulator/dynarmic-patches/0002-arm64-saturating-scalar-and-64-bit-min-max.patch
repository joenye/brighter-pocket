 using namespace oaknut::util;
 
+// The A64 scalar saturating forms (SQADD, UQSUB, SQDMULH and the rest on B, H, S and D registers):
+// the host's own instruction on the value's element, which sets the host's FPSR.QC as the guest's.
+template<size_t bitsize, typename EmitFn>
+static void EmitSaturatedScalar(oaknut::CodeGenerator&, EmitContext& ctx, IR::Inst* inst, EmitFn emit) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    auto realize = [&](auto Vresult, auto Va, auto Vb) {
+        RegAlloc::Realize(Vresult, Va, Vb);
+        ctx.fpsr.Load();
+        emit(*Vresult, *Va, *Vb);
+    };
+    if constexpr (bitsize == 8) {
+        realize(ctx.reg_alloc.WriteB(inst), ctx.reg_alloc.ReadB(args[0]), ctx.reg_alloc.ReadB(args[1]));
+    } else if constexpr (bitsize == 16) {
+        realize(ctx.reg_alloc.WriteH(inst), ctx.reg_alloc.ReadH(args[0]), ctx.reg_alloc.ReadH(args[1]));
+    } else if constexpr (bitsize == 32) {
+        realize(ctx.reg_alloc.WriteS(inst), ctx.reg_alloc.ReadS(args[0]), ctx.reg_alloc.ReadS(args[1]));
+    } else {
+        realize(ctx.reg_alloc.WriteD(inst), ctx.reg_alloc.ReadD(args[0]), ctx.reg_alloc.ReadD(args[1]));
+    }
+}
+
