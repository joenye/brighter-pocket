 using namespace oaknut::util;
 
+// Scalar half-precision forms oaknut has no mnemonic for (FEAT_FP16, which every Apple silicon
+// host has): the A64 encoding with ftype 0b11, from the registers' numbers.
+static void EmitHalf(oaknut::CodeGenerator& code, u32 encoding, oaknut::HReg d, oaknut::HReg n) {
+    code.dw(encoding | (static_cast<u32>(n.index()) << 5) | static_cast<u32>(d.index()));
+}
+
+static void EmitHalf(oaknut::CodeGenerator& code, u32 encoding, oaknut::HReg d, oaknut::HReg n, oaknut::HReg m, oaknut::HReg a) {
+    code.dw(encoding | (static_cast<u32>(m.index()) << 16) | (static_cast<u32>(a.index()) << 10) | (static_cast<u32>(n.index()) << 5) | static_cast<u32>(d.index()));
+}
