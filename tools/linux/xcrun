#!/bin/bash
# xcrun on Linux, for the platform's own scripts (tools/build_shims.py): the iOS SDK in
# IOS_SDK and the LLVM toolchain in POCKET_LLVM (bin/clang, bin/llvm-nm, ld64.lld).
# Only what those scripts ask is answered; anything else fails loudly.
set -euo pipefail
: "${IOS_SDK:?IOS_SDK names the iPhoneOS SDK}" "${POCKET_LLVM:?POCKET_LLVM names the LLVM toolchain}"
sdk=iphoneos
while [ $# -gt 0 ]; do
    case "$1" in
        --sdk) sdk=$2; shift 2;;
        --show-sdk-path) [ "$sdk" = iphoneos ] || { echo "xcrun: only the iphoneos SDK here" >&2; exit 1; }; echo "$IOS_SDK"; exit 0;;
        --show-sdk-build-version) sed -n 's/.*"ProductBuildVersion" *: *"\([^"]*\)".*/\1/p; s/.*"Version" *: *"\([^"]*\)".*/\1/p' "$IOS_SDK/SDKSettings.json" | head -1; exit 0;;
        clang|clang++) tool=$1; shift
            # Compiling and linking alike: Apple's ld is LLVM's ld64.lld here.
            exec "$POCKET_LLVM/bin/$tool" -fuse-ld=lld -Wno-unused-command-line-argument "$@";;
        nm) shift; exec "$POCKET_LLVM/bin/llvm-nm" "$@";;
        otool) shift; exec "$POCKET_LLVM/bin/llvm-otool" "$@";;
        *) echo "xcrun stand-in: $1 is not provided on Linux" >&2; exit 1;;
    esac
done
