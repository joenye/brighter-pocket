#!/usr/bin/env python3
"""dyld_info on Linux, for the platform's tools/classify.py: -imports, -exports and -fixups
of a chained-fixups arm64 image, printed in the lines classify.py parses, from
tools/macho.py's reading of the file.

usage: dyld_info -arch arm64 (-imports | -exports | -fixups) FILE
"""
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import macho  # noqa: E402


def leaf(install_name: str) -> str:
    """What dyld_info prints after 'from': the library's leaf name, version suffix dropped."""
    if install_name.startswith("<"):
        return install_name
    return re.sub(r"\.(\w+\.)?dylib$", "", install_name.rsplit("/", 1)[-1])


def main() -> int:
    args = sys.argv[1:]
    if len(args) != 4 or args[0] != "-arch" or args[1] != "arm64" or args[2] not in ("-imports", "-exports", "-fixups"):
        print("dyld_info stand-in: only -arch arm64 -imports|-exports|-fixups FILE", file=sys.stderr)
        return 1
    _, image = macho.load(args[3])
    print(f"{args[3]} [arm64]:")
    print(f"    {args[2]}:")
    if args[2] == "-imports":
        for index, imp in enumerate(image.imports()):
            weak = " [weak-import]" if imp.weak else ""
            print(f"        0x{index:04X}  {imp.name}{weak} (from {leaf(image.library(imp.ordinal))})")
    elif args[2] == "-exports":
        for name, address in sorted(image.exports().items(), key=lambda e: e[1]):
            print(f"        0x{address:08X}  {name}")
    # -fixups: classify.py looks only for lazy binds, which chained fixups never have.
    return 0


if __name__ == "__main__":
    sys.exit(main())
