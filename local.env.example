# Copy to local.env (ignored by git) and fill in your own values. One file serves this
# repository's tools and the platform's: tools/prepare.py copies it into build/platform,
# where Tolkara's own scripts read it (platform/local.env.example lists everything they
# take). Quote values that contain spaces. The environment wins over this file.

# --- this repository's tools ---------------------------------------------------------------
# The Steam account that owns Brighter Shores, for tools/fetch_client.py (Steam's content
# servers only; DepotDownloader keeps the login token after the first login).
STEAM_USER=
# Optional: the DepotDownloader binary (default: Brighter Atlas's, beside this repository,
# whose remembered login is then reused).
#DEPOT_DOWNLOADER=/path/to/DepotDownloader
# An iPhoneOS SDK folder (Xcode's iPhoneOS.sdk, copied), for tests/run.sh's iOS checks,
# tools/analyze_client.py --sdk and the Linux build (tools/build_ios.py).
#IOS_SDK=/path/to/iPhoneOS.sdk
# Optional overrides of what tools/linux/setup_toolchain.sh installs in .toolchain/.
#POCKET_LLVM=/path/to/llvm
#LDID=/path/to/ldid

# --- the platform's (Tolkara's) settings, used on a Mac and by the copy helper ---------------
# Your Apple Developer team ID; not needed for the unsigned Linux build.
#DEVELOPMENT_TEAM=
# Unique to you; the copy helper (profiles/brighter-shores/install.py) copies into this app.
TOLKARA_BUNDLE_ID=local.tolkara.yourname
# The device's UDID, for the copy helper and the platform's install scripts.
#DEVICE=
# On a Mac, a build made for this client (see docs/building.md):
#GUEST_EXE="/path/to/Brighter Shores.app/Contents/MacOS/Brighter Shores"
#TOLKARA_MODE=local-signing
