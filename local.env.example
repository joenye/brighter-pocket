# Copy to local.env (ignored by git) and fill in your own values. One file serves this
# repository's tools and the platform's: tools/prepare.py copies it into build/platform,
# where Tolkara's own scripts read it (platform/local.env.example lists everything they
# take). Quote values that contain spaces. The environment wins over this file.

# --- this repository's tools ---------------------------------------------------------------
# Xcode's developer folder, when xcode-select names another (the Command Line Tools, or a
# second Xcode). Every tool reaches Xcode through xcrun with this.
#DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# The Steam account that owns Brighter Shores. The emulator's --steam-live and
# tools/run_simulator.py sign in with the refresh token DepotDownloader remembers for it
# (account.config under ~/Library/Application Support/IsolatedStorage).
STEAM_USER=
# Optional: another steamapps folder than the Steam app's own, for tools/fetch_client.py.
#STEAM_LIBRARY=/path/to/steamapps
# Optional: the DepotDownloader binary, for tools/fetch_client.py --depot.
#DEPOT_DOWNLOADER=/path/to/DepotDownloader
# The simulator tools/run_simulator.py uses (default: iPad Pro 13-inch (M5)).
#SIMULATOR="iPad Pro 13-inch (M5)"

# --- the platform's (Tolkara's) settings, also used by the copy helper -----------------------
# Your Apple Developer team ID; not needed for the unsigned .ipa or the simulator.
#DEVELOPMENT_TEAM=
# Unique to you; the copy helper (profiles/brighter-shores/install.py) copies into this app.
TOLKARA_BUNDLE_ID=local.tolkara.yourname
# The device's UDID, for the copy helper and the platform's install scripts.
#DEVICE=
# For the platform's own Xcode build, made for this client (see docs/building.md):
#GUEST_EXE="/path/to/Brighter Shores.app/Contents/MacOS/Brighter Shores"
#TOLKARA_MODE=local-signing
