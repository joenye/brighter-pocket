+// presentDrawable:afterMinimumDuration: (the simulator's) is paced here instead: a present
+// waits until the cap has passed since the one before.
+static void observedPresent(id command,SEL selector,id<MTLDrawable> drawable) {
+    if(captureFrames) markCapture(command,drawable);
+    timeGPU(command);
+    atomic_store(&gameInterval,0);
