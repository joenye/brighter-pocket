+// A drawable shown on screen: count it, and its gap to the one before. Handlers run on
+// several threads; a time older than the newest is not counted. A dropped drawable has none.
+static void recordPresented(double time) {
+    if(time<=0)return;
+    double previous=atomic_load(&lastPresented);
+    do { if(time<=previous)return; } while(!atomic_compare_exchange_weak(&lastPresented,&previous,time));
+    atomic_fetch_add(&timedFrames,1);
+    if(previous<=0)return;
+    double gap=time-previous,longest=atomic_load(&longestGap);
+    while(gap>longest && !atomic_compare_exchange_weak(&longestGap,&longest,gap)) {}
+}
+static void recordLongest(_Atomic double *slot, double value) {
+    double longest=atomic_load(slot);
+    while(value>longest && !atomic_compare_exchange_weak(slot,&longest,value)) {}
+}
+static void timeGPU(id<MTLCommandBuffer> command) {
+    [command addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        double time=done.GPUEndTime-done.GPUStartTime;
+        if(isfinite(time) && time>0) recordLongest(&longestGPUTime,time);
+    }];
+}
