+    suffix='-simulator' if simulator else ''
+    target=('air64-apple-ios14.0' if legacy else 'air64-apple-ios'+versions[air])+suffix
     compiler=compiler or compiler_path()
     output.parent.mkdir(parents=True,exist_ok=True)
