+// Brighter Pocket's in-game settings (PocketSettings.m): the resolution, kept, and every window told now.
+void AKSetResolution(CGFloat share) {
+    resolution = share >= 0.5 && share <= 1 ? share : 1;
+    [NSUserDefaults.standardUserDefaults setDouble:resolution forKey:@"PocketResolution"];
+    for (NSWindow *window in NSApp.windows) [window ak_resolutionChanged];
+}
