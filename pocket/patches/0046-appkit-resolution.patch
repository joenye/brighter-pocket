+// Brighter Pocket's resolution (the in-game settings' Resolution, defaults key PocketResolution: the share of the
+// screen's resolution, 0.5 to 1). The game is told a window, and a screen, that share of the host's size, at the
+// screen's own density: it renders that share of the pixels each way, and its picture is stretched to fill the host
+// (ak_hostBoundsChanged). Fewer pixels: smoother and lighter on the battery, softer to look at. Touches are divided
+// by it on their way to the game (postMouse), so a tap lands where it is drawn.
+static CGFloat resolution = 0;
+CGFloat AKResolution(void) {
+    if (resolution <= 0) {
+        double kept = [NSUserDefaults.standardUserDefaults doubleForKey:@"PocketResolution"];
+        resolution = kept >= 0.5 && kept <= 1 ? kept : 1;
+    }
+    return resolution;
+}
