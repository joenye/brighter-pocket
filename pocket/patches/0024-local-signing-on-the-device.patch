--- a/tools/install.sh
+++ b/tools/install.sh
@@ -71,6 +71,12 @@
         sleep 3
         copy_containers || { echo "PAGE CONTAINER COPY FAILED -> $LOG"; exit 1; }
     fi
+    # Your developer identity, once, so the app signs the container for a new build of a game
+    # itself (tools/give_signing_identity.sh): an update then needs no Mac to sign it.
+    if [ -x tools/give_signing_identity.sh ]; then
+        tools/give_signing_identity.sh "$DEVICE" "$BUNDLE" "$DEVELOPMENT_TEAM" \
+            || echo "Note: the app has no developer identity yet, so it cannot sign a new game build itself; run tools/give_signing_identity.sh."
+    fi
     echo "Installed with Local signing and ${#BUILT[@]} page container(s). Nothing to enrol. Next: copy your apps' files (see profiles/).";;
 developer-service)
     echo "Installed with Developer service. Next: tools/enroll.sh (once), then copy your apps' files (see profiles/).";;
