+def module_end(data,table,public,offset,code_size):
+    # AIR 1.x containers (version 2, Xcode 9 and older) name no module size: a module
+    # runs to the next module offset in the function table, or to the code section's end.
+    end=max(code_size,offset);count=struct.unpack_from('<I',data,table)[0];pos=table+4
+    for _ in range(count):
+        if public-pos<4: break
+        size=struct.unpack_from('<I',data,pos)[0]
+        if size<8 or size>public-pos: break
+        record_end=pos+size;pos+=4
+        while record_end-pos>=6 and data[pos:pos+4]!=b'ENDT':
+            n=struct.unpack_from('<H',data,pos+4)[0];pos+=6
+            if n>record_end-pos: break
+            if data[pos-6:pos-2]==b'OFFT' and n==24:
+                other=struct.unpack_from('<Q',data,pos+16)[0]
+                if offset<other<end: end=other
+            pos+=n
+        pos=record_end
+    return end
+
