 #pragma mark Library
 
+// The app a plain launch starts by itself: the library's default one, once an execution mode
+// is chosen and the app can start.
+- (TKApp *)defaultStartableApp {
+    if (!self.executionMode || !CanStartApps()) return nil;
+    [self.library discover];
+    return self.library.defaultApp;
+}
+- (void)startDefaultApp {
+    TKApp *app=[self defaultStartableApp];
+    if (app) [self libraryViewController:self.libraryController startApp:app];
+}
