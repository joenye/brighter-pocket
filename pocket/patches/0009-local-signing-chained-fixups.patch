+def codesign_identity(unsigned, output, identity, team, identifier):
+    """Sign with codesign(1), whose access to the key Xcode's builds already granted: each valid
+    code-signing identity whose name contains `identity` (or is that SHA-1) is tried until the
+    signature names `team` (any, without one)."""
+    listed = subprocess.run(['security', 'find-identity', '-v', '-p', 'codesigning'], capture_output=True, text=True).stdout
+    candidates = [(sha, name) for sha, name in re.findall(r'^\s*\d+\) ([0-9A-F]{40}) "(.*)"$', listed, re.M)
+                  if identity in name or identity.upper() == sha]
+    if not candidates: raise BuildError(f'no valid code-signing identity matches "{identity}" (Xcode signs in to your account once)')
+    for sha, name in candidates:
+        work = output.with_name('.codesign-' + output.name)
+        shutil.copyfile(unsigned, work)
+        result = subprocess.run(['codesign', '--force', '--sign', sha, '--identifier', identifier, '--pagesize', '16384',
+                                 '--timestamp=none', str(work)], capture_output=True, text=True)
+        details = subprocess.run(['codesign', '-dvv', str(work)], capture_output=True, text=True).stderr
+        if not result.returncode and (not team or f'TeamIdentifier={team}' in details):
+            os.replace(work, output)
+            print(f'identity: {sha} {name}')
+            return
+        work.unlink(missing_ok=True)
+        if result.returncode: raise BuildError(f'codesign failed: {result.stderr.strip()}')
+    raise BuildError(f'no identity matching "{identity}" belongs to team {team}')
+
