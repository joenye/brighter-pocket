+def no_fixups_in_text(data, chained, text_index):
+    """The container maps __TEXT read and execute: refuse an executable with a fixup chain in it."""
+    dataoff, datasize = chained
+    if not within(dataoff, datasize, len(data)) or datasize < 28: raise BuildError('chained fixups lie outside the file')
+    starts = dataoff + u32(data, dataoff + 4)
+    if not within(starts, 4, dataoff + datasize): raise BuildError('malformed chained fixups')
+    count = u32(data, starts)
+    if text_index >= count: return
+    if not within(starts + 4, 4 * count, dataoff + datasize): raise BuildError('malformed chained fixups')
+    info = u32(data, starts + 4 + 4 * text_index)
+    if not info: return
+    segment = starts + info
+    if not within(segment, 22, dataoff + datasize): raise BuildError('malformed chained fixups')
+    pages = struct.unpack_from('<H', data, segment + 20)[0]
+    if not within(segment + 22, 2 * pages, dataoff + datasize): raise BuildError('malformed chained fixups')
+    if any(struct.unpack_from('<H', data, segment + 22 + 2 * i)[0] != CHAINED_START_NONE for i in range(pages)):
+        raise BuildError('a fixup lands in __TEXT, which the page container maps read and execute')
+
