# Brighter Pocket's defaults for the platform's own builds (tools/install.sh, run.sh,
# package_ipa.sh; pocket/patches/0022): tools/localenv.sh reads this before local.env, and
# local.env and the environment win. Committed: nothing personal goes here.
# The app's name on the Home Screen ("Brighter Pocket" was too long there), and its full name,
# which its own text uses (pocket/patches/0035).
TOLKARA_DISPLAY_NAME="Pocket"
TOLKARA_APP_NAME="Brighter Pocket"
# The profiles the app carries: Brighter Shores only, not the platform's others.
TOLKARA_PROFILES=brighter-shores
# How games run: Local signing only. Developer service (Tolkara's tunnel route) is never offered
# by Brighter Pocket; the build preselects Local signing and its library hides the chooser.
TOLKARA_MODE=local-signing
